---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  centered?: boolean;
  noTopPadding?: boolean;
}

const { items, centered = false, noTopPadding = false } = Astro.props;
---

<nav aria-label="Breadcrumb" class={`w-full px-6 ${noTopPadding ? 'pb-3 pt-0' : 'py-3'}`}>
  <ol class={`max-w-7xl mx-auto flex items-center list-none p-0 ${centered ? 'justify-center' : ''}`}>
    <!-- Home Icon -->
    <li class="flex items-center">
      <a href="/Sam-Lee-Home/" class="text-brand-primary hover:opacity-80 transition-opacity" title="Home">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
          <polyline points="9 22 9 12 15 12 15 22" />
        </svg>
      </a>
    </li>

    {items.map((item, index) => (
      <li class="flex items-center">
        <!-- Chevron Separator -->
        <div class="flex items-center justify-center px-2 text-gray-400">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </div>
        
        <!-- Breadcrumb Link/Text -->
        {item.href ? (
          <a 
            href={item.href} 
            class={`px-2 py-1 text-sm font-medium transition-colors ${
              index === items.length - 1 
              ? 'text-gray-600 cursor-default' 
              : 'text-brand-primary hover:underline'
            }`}
          >
            {item.label}
          </a>
        ) : (
          <span class={`px-2 py-1 text-sm font-medium transition-colors ${
            index === items.length - 1 
            ? 'text-gray-600 cursor-default' 
            : 'text-gray-600'
          }`}>
            {item.label}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>