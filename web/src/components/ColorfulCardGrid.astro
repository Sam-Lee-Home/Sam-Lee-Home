---
interface Props {
  headerText?: string;
}

const { headerText } = Astro.props;
---

<section class="max-w-7xl mx-auto px-6 py-20">
  {headerText && (
    <div class="mb-12">
      <h2 class="text-brand-primary font-bold uppercase tracking-widest text-sm">
        {headerText}
      </h2>
    </div>
  )}
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
    <slot />
  </div>
</section>
