---
interface Props {
  themeColor: string; // Tailwind class like 'bg-card-coral'
  headerText: string;
  title: string;
  description: string;
}

const { themeColor, headerText, title, description } = Astro.props;
---

<div class={`rounded-3xl border-2 border-brand-primary flex flex-col h-full transition-transform hover:scale-105 duration-300 overflow-hidden`}>
  <div class={`p-8 ${themeColor}`}>
    <div class="inline-block px-2 py-1 rounded-md bg-brand-primary text-white text-[10px] font-bold tracking-wider uppercase w-fit">
      {headerText}
    </div>
  </div>
  
  <div class="p-8 bg-white flex flex-col gap-6 flex-1">
    <div class="flex flex-col gap-2">
      <h3 class="font-sans font-bold text-xl text-gray-900">
        {title}
      </h3>
      <div class="font-sans text-gray-700 leading-relaxed" set:html={description} />
    </div>
  </div>
</div>
