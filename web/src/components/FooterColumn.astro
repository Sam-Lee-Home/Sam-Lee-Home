---
interface FooterItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  items: FooterItem[];
}

const { title, items } = Astro.props;
---

<div class="flex flex-col gap-4">
  <h3 class="text-white font-bold text-lg">
    {title}
  </h3>
  <ul class="flex flex-col gap-3">
    {items.map(item => (
      item.href ? (
        <li>
          <a 
            href={item.href} 
            class="hover:text-white transition-colors duration-200 text-sm"
            target={item.href.startsWith('mailto:') ? '_blank' : undefined}
            rel={item.href.startsWith('mailto:') ? 'external' : undefined}
          >
            {item.label}
          </a>
        </li>
      ) : (
        <li class="text-sm leading-loose">
          {item.label}
        </li>
      )
    ))}
  </ul>
</div>