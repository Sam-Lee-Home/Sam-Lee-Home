---
import Layout from '../layouts/Layout.astro';
import MinimalHeader from '../components/MinimalHeader.astro';
import StructuredDarkFooter from '../components/StructuredDarkFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const privacyCards = await getCollection('privacy');
const sortedCards = privacyCards.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const breadcrumbs = [
  { label: 'Privacy Policy', href: '/privacy' },
];
---

<Layout>
    <MinimalHeader />

    <main class="px-4 pb-8 pt-0 md:px-8 lg:px-16 max-w-7xl mx-auto">
      <Breadcrumbs items={breadcrumbs} centered noTopPadding />

      <div class="flex flex-col gap-8">
        {sortedCards.map((card) => (
          <div class="flex flex-col border-2 border-[var(--color-brand-primary)] rounded-lg overflow-hidden bg-white shadow-sm w-full">
            <div class="bg-[var(--color-brand-primary)] px-4 py-3">
              <h3 class="text-white font-bold text-xl font-serif">
                {card.data.title}
              </h3>
            </div>
            <div class="p-6 flex-grow">
              <p class="text-gray-700 leading-relaxed" set:html={card.data.description} />
            </div>
          </div>
        ))}
      </div>
    </main>

    <StructuredDarkFooter />
</Layout>
